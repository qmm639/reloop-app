# ---------- แกนระบบ ----------
DATABASE_URL="file:./dev.db"          # dev: SQLite | prod: postgresql://user:pass@host:5432/reloop
APP_URL="http://localhost:3000"
AUTH_SECRET="เปลี่ยนเป็นค่าสุ่ม 32 ตัวอักษรขึ้นไป"
TOKEN_ENC_KEY="คีย์ 32 ไบต์ในรูป base64 สำหรับเข้ารหัส access token"
STORAGE_DIR="./storage"

# ---------- 2) OAuth ของแต่ละแพลตฟอร์ม ----------
# Google / YouTube — console.cloud.google.com > APIs & Services
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# TikTok — developers.tiktok.com (ต้องยื่นขอ scope video.publish)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Meta (Facebook Page + Instagram) — developers.facebook.com
META_APP_ID=""
META_APP_SECRET=""
META_API_VERSION="v21.0"
# ถ้าเจอ Invalid Scopes ให้ลดสิทธิ์ที่ขอชั่วคราว เช่น "public_profile"
# แล้วค่อยเพิ่มกลับเมื่อเปิด use case ในหน้า App Dashboard ครบแล้ว
META_SCOPES=""

# ---------- 3) ประมวลผลวิดีโอ ----------
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
WORKER_CONCURRENCY="2"
# ถอดเสียงเป็นซับ: openai | local | off
TRANSCRIBE_PROVIDER="off"
OPENAI_API_KEY=""
# ถ้าใช้ local ให้ชี้ไปที่ไบนารี whisper.cpp และไฟล์โมเดล
WHISPER_BIN=""
WHISPER_MODEL=""

# ---------- 4) ชำระเงิน ----------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_CREATOR=""
STRIPE_PRICE_AGENCY=""
